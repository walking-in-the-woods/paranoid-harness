PROXY_SECRET=replace-me-with-openssl-rand-hex-32

HARNESS_MODEL=qwen3:8b
HARNESS_MODEL_DIGEST=

SMOKE_MODEL=qwen3:1.7b
SMOKE_MODEL_SMALL=qwen3:0.6b

UID=1000
GID=1000

# --- Гейтвей --------------------------------------------------------------
# HMAC-ключ для prompt_hash в gateway.jsonl (≥32 символа).
# Сгенерировать: openssl rand -hex 32
GATEWAY_HMAC_KEY=replace-with-openssl-rand-hex-32

# Токены клиентов гейтвея. Хеши — в config/gateway_clients.yaml.
#
# Имя переменной вычисляется из имени клиента:
#   PREFIX = name.upper().replace("-", "_")
#   env-var = PREFIX + "_GATEWAY_TOKEN"
#
# Проект поставляется с двумя клиентами (harness, webui).
# При добавлении нового клиента — скопируйте строку и подставьте
# свой PREFIX.
#
# Сгенерировать вручную: bash scripts/gateway-tokens.sh <name>
# Автоматически (заполнит placeholder'ы в YAML):
#   bash scripts/bootstrap.sh
HARNESS_GATEWAY_TOKEN=replace-with-openssl-rand-hex-32
WEBUI_GATEWAY_TOKEN=replace-with-openssl-rand-hex-32

# --- Образ Ollama ---------------------------------------------------------
# Для локальной разработки:
#   OLLAMA_IMAGE=ollama/ollama:latest
# Для paranoid-режима (пиннинг по digest):
#   docker pull ollama/ollama:latest
#   docker inspect --format='{{index .RepoDigests 0}}' ollama/ollama:latest
#   OLLAMA_IMAGE=ollama/ollama@sha256:<hex>
OLLAMA_IMAGE=ollama/ollama:latest
