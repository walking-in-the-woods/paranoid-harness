# Скопируйте в .env и отредактируйте:
#   cp .env.example .env
#
# PROXY_SECRET — обязательно, сгенерировать:
#   openssl rand -hex 32
PROXY_SECRET=replace-me-with-openssl-rand-hex-32

# Рабочая модель. Должна поддерживать tool calling.
# ВНИМАНИЕ: тег `qwen3:8b` мутабельный — upstream может перезаписать
# его новой версией. Для пиннинга используйте HARNESS_MODEL_DIGEST.
HARNESS_MODEL=qwen3:8b

# ОПЦИОНАЛЬНО: ожидаемый digest модели ("sha256:<hex>" или "<hex>").
#
# ВАЖНО: этот параметр защищает от ПОСЛЕДУЮЩЕЙ подмены тега (если вы
# уже один раз проверили модель и она попала в локальный кеш/volume).
# При первом pull компрометация реестра Ollama приведёт к совпадению
# digest на вредоносной версии — проверка не даёт гарантии подлинности
# при первой загрузке.
#
# Для защиты от компрометации реестра ожидаемый digest должен
# приходить из out-of-band канала: подписанного релиза проекта,
# официального сайта, независимого источника. См. docs/operations.md.
#
# Если вы берёте digest из того же источника, из которого делаете pull
# (например, `ollama list --json`), вы проверяете только стабильность
# относительно предыдущего pull, а не подлинность.
HARNESS_MODEL_DIGEST=

# Тестовая модель с tool calling.
SMOKE_MODEL=qwen3:1.7b

# Тестовая модель для быстрых smoke (sentinel/JSON/ASCII).
SMOKE_MODEL_SMALL=qwen3:0.6b

# UID/GID хоста (id -u, id -g).
UID=1000
GID=1000
