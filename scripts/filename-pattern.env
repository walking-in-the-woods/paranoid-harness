# Единый источник паттерна для проверки однобуквенных имён файлов.
#
# Используется:
#   - scripts/self-test-filename-pattern.sh
#
# Формат: shell-совместимое присваивание. Подключать через
# `. scripts/filename-pattern.env` или `source`.
#
# Правило проекта — в docs/development.md, раздел «Стиль имён».
# Паттерн — частичная эвристика для исторических кейсов A–J;
# см. комментарий в self-test.
#
# Разбор паттерна:
#   "                 — открывающая двойная кавычка.
#   \$                — литерал $ (в ERE \$ — escape, не якорь).
#   [A-Za-z]+         — имя переменной.
#   /                 — слэш.
#   [A-Ja-j]          — одна буква A–J (заглавная или строчная).
#   [".]              — character class из ДВУХ символов: " или .
#                       В POSIX ERE внутри [...] обратный слэш —
#                       литерал; ["\.] соответствовал бы трём
#                       символам (", \, .).
forbidden_filenames_pattern='"\$[A-Za-z]+/[A-Ja-j][".]'
